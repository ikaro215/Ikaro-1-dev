
import java.util.Scanner;
import java.util.ArrayList;

public class CatalogoCursos {
    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        // Array com as cargas horárias dos 10 cursos
        int[] cargaHoraria = new int[10];

        // Lista para armazenar os cursos de longa duração
        ArrayList<Integer> cursosLongos = new ArrayList<>();

        // Leitura e validação das cargas horárias
        for (int i = 0; i < cargaHoraria.length; i++) {

            do {
                System.out.print("Digite a carga horária do Curso "
                        + (i + 1) + ": ");
                cargaHoraria[i] = entrada.nextInt();

                if (cargaHoraria[i] <= 0 || cargaHoraria[i] > 400) {
                    System.out.println("Valor inválido! Digite entre 1 e 400.");
                }

            } while (cargaHoraria[i] <= 0 || cargaHoraria[i] > 400);
        }

        // Listagem dos cursos
        System.out.println("\n--- LISTA DE CURSOS ---");

        for (int i = 0; i < cargaHoraria.length; i++) {
            System.out.println("Curso " + (i + 1) + ": "
                    + cargaHoraria[i] + " horas");
        }

        // Cálculo do total e da média
        int total = 0;

        for (int i = 0; i < cargaHoraria.length; i++) {
            total += cargaHoraria[i];
        }

        double media = (double) total / cargaHoraria.length;

        System.out.println("\nTotal de horas: " + total);
        System.out.println("Média de horas: " + media);

        // Identificação do maior e menor curso
        int maior = cargaHoraria[0];
        int menor = cargaHoraria[0];
        int cursoMaior = 1;
        int cursoMenor = 1;

        for (int i = 1; i < cargaHoraria.length; i++) {

            if (cargaHoraria[i] > maior) {
                maior = cargaHoraria[i];
                cursoMaior = i + 1;
            }

            if (cargaHoraria[i] < menor) {
                menor = cargaHoraria[i];
                cursoMenor = i + 1;
            }
        }

        System.out.println("\nMaior carga horária: Curso "
                + cursoMaior + " - " + maior + " horas");

        System.out.println("Menor carga horária: Curso "
                + cursoMenor + " - " + menor + " horas");

        // Classificação dos cursos
        int curta = 0;
        int mediaDuracao = 0;
        int longa = 0;

        for (int i = 0; i < cargaHoraria.length; i++) {

            if (cargaHoraria[i] < 40) {
                curta++;

            } else if (cargaHoraria[i] < 100) {
                mediaDuracao++;

            } else {
                longa++;
                cursosLongos.add(cargaHoraria[i]);
            }
        }

        System.out.println("\n--- CLASSIFICAÇÃO ---");
        System.out.println("Curta duração: " + curta);
        System.out.println("Média duração: " + mediaDuracao);
        System.out.println("Longa duração: " + longa);

        // Exibição dos cursos longos
        System.out.println("\n--- CURSOS DE LONGA DURAÇÃO ---");

        if (cursosLongos.isEmpty()) {
            System.out.println("Nenhum curso de longa duração.");
        } else {
            System.out.println(cursosLongos);
        }

        // Busca de uma carga horária específica
        System.out.print("\nDigite uma carga horária para buscar: ");
        int busca = entrada.nextInt();

        int quantidade = 0;

        System.out.println("Cursos encontrados:");

        for (int i = 0; i < cargaHoraria.length; i++) {

            if (cargaHoraria[i] == busca) {
                System.out.println("Curso " + (i + 1));
                quantidade++;
            }
        }

        if (quantidade == 0) {
            System.out.println("Nenhum curso com essa carga horária.");
        } else {
            System.out.println("Quantidade encontrada: " + quantidade);
        }

        // Exibição das cargas horárias em ordem inversa
        System.out.println("\n--- ORDEM INVERSA ---");

        for (int i = cargaHoraria.length - 1; i >= 0; i--) {
            System.out.println("Curso " + (i + 1) + ": "
                    + cargaHoraria[i] + " horas");
        }

        entrada.close();
    }
}
